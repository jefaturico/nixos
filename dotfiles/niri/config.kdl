
input {
    keyboard {
	    repeat-rate 50
	    repeat-delay 200
        xkb {
            layout "us"
	        variant "altgr-intl"
        }
    }

    touchpad {
        tap
        dwt
       drag-lock
        natural-scroll
        accel-speed 0.2
        accel-profile "adaptive"
        scroll-factor 0.5
        scroll-method "two-finger"
        disabled-on-external-mouse
    }

    mouse {
        // natural-scroll
        // accel-speed 0.2
        accel-profile "flat"
        // scroll-method "no-scroll"
    }

    trackpoint {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "on-button-down"
        // scroll-button 273
        // scroll-button-lock
        // middle-emulation
    }

    warp-mouse-to-focus

    focus-follows-mouse max-scroll-amount="0%"

    disable-power-key-handling
}

output "HP Inc. HP E223 3CQ9152Q27" {
    mode "1920x1080@60.000"
    scale 1
    transform "normal"
    position x=0 y=100
    backdrop-color "#000000"
}

output "eDP-1" {
    mode "2880x1920@60.000"
    variable-refresh-rate
    scale 2
    transform "normal"
    position x=1920 y=0
    backdrop-color "#000000"
}

layout {
    gaps 0
    center-focused-column "never"
    background-color "transparent"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    border {
        off
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    struts {
        // left 10
        // right 10
        // top 10
        // bottom<D-n> 10
    }
}

cursor {
    hide-when-typing
    hide-after-inactive-ms 5000
}

layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}

overview {
    workspace-shadow {
        off
    }
}

hotkey-overlay {
    skip-at-startup
}
animations {
    // off
    slowdown 0.7
}

gestures { 
    hot-corners { 
      off 
    } 
}
window-rule {
    match title=".*Mozilla Thunderbird"
    default-column-width { proportion 1.0; }
    open-maximized true
}

window-rule {
    match app-id="org.gnome.Calendar"
    default-column-width { proportion 1.0; }
}

window-rule {
    match app-id="task"
    default-column-width { proportion 0.33333; }
}

window-rule {
    match app-id="steam"
    default-column-width { proportion 1.0; }
}

window-rule {
    match title="Bitwarden"
    default-column-width { proportion 0.33333; }
    open-maximized true
}

window-rule {
    match title="Write:*"
    match app-id="^(org.mozilla.Thunderbird|thunderbird)$"
    default-column-width { proportion 0.5; }
}

window-rule {
    match app-id="brave-origin"
    default-column-width { proportion 0.5; }
    open-maximized false
}

prefer-no-csd

screenshot-path "~/images/screenshots/%Y%m%d%H%M%S.png"
spawn-sh-at-startup "swaybg -i /home/jefaturico/images/wallpapers/forest-fog-deer-3840x2160.jpg"
spawn-sh-at-startup "$HOME/.scripts/idle-behavior"

binds {

    Mod+Return { spawn "foot"; }
    Mod+X { spawn "fuzzel"; }

    Mod+W { spawn "brave-origin"; }
    Mod+Shift+W { spawn-sh "/home/jefaturico/.scripts/bookmarks"; }    
    Mod+Backspace { spawn "emacs"; }
    Mod+D { spawn-sh "/home/jefaturico/.scripts/find-document"; }
    Mod+T { spawn-sh "/home/jefaturico/.scripts/systeminfo"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "/home/jefaturico/.scripts/volume up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "/home/jefaturico/.scripts/volume down"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "/home/jefaturico/.scripts/volume mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }

    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    Mod+O repeat=false { toggle-overview; }

    Mod+Escape repeat=false { close-window; }

    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-or-workspace-down; }
    Mod+Up    { focus-window-or-workspace-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+K     { focus-window-or-workspace-down; }
    Mod+I     { focus-window-or-workspace-up; }
    Mod+L     { focus-column-right; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+K     { move-window-down; }
    Mod+Shift+I     { move-window-up; }
    Mod+Shift+L     { move-column-right; }

    Mod+WheelScrollUp cooldown-ms=150 { focus-window-or-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-window-or-workspace-down; }
    Mod+Shift+WheelScrollDown cooldown-ms=150 { focus-column-right; }
    Mod+Shift+WheelScrollUp cooldown-ms=150 { focus-column-left; }
    Mod+MouseMiddle { toggle-overview; }

    Mod+Period                { focus-monitor-next; }
    Mod+Shift+Period          { move-column-to-monitor-next; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    Mod+Shift+Ctrl+I { move-workspace-up; }
    Mod+Shift+Ctrl+K { move-workspace-down; }
        
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Shift+Ctrl+R { reset-window-height; }

    Mod+M { maximize-column; }
    Mod+Shift+M { fullscreen-window; }

    Mod+V { switch-focus-between-floating-and-tiling; }
    Mod+Shift+Ctrl+V       { toggle-window-floating; }

    Mod+Shift+T { toggle-column-tabbed-display; }

    Mod+S { screenshot; }
    Mod+Shift+S { screenshot-window; }
    Mod+Ctrl+Shift+S { screenshot-screen; }

    Mod+Ctrl+Shift+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    Mod+Shift+Escape { quit; }
}

