diff --git a/notification.c b/notification.c
index 9daedc7..ab4f928 100644
--- a/notification.c
+++ b/notification.c
@@ -1433,6 +1433,39 @@ struct glyph_layout {
 
 typedef tll(struct glyph_layout) glyph_list_t;
 
+static void
+center_glyphs_vertically(glyph_list_t *glyphs, int top, int bottom)
+{
+    if (tll_length(*glyphs) == 0 || bottom <= top)
+        return;
+
+    int glyph_top = bottom;
+    int glyph_bottom = top;
+
+    tll_foreach(*glyphs, it) {
+        const struct fcft_glyph *glyph = it->item.glyph;
+        const int y = it->item.y - glyph->y;
+
+        glyph_top = min(glyph_top, y);
+        glyph_bottom = max(glyph_bottom, y + glyph->height);
+
+        if (it->item.underline.draw) {
+            glyph_top = min(glyph_top, it->item.underline.y);
+            glyph_bottom = max(
+                glyph_bottom,
+                it->item.underline.y + it->item.underline.thickness);
+        }
+    }
+
+    const int offset = top + (bottom - top - (glyph_bottom - glyph_top)) / 2
+        - glyph_top;
+
+    tll_foreach(*glyphs, it) {
+        it->item.y += offset;
+        it->item.underline.y += offset;
+    }
+}
+
 static void
 notif_layout(struct notif *notif, struct font_set *fonts,
              const pixman_color_t *color, enum fcft_subpixel subpixel,
@@ -1962,6 +1995,11 @@ notif_show(struct notif *notif, int y)
     if (conf->max_height > 0)
         height = min(height, conf->max_height);
 
+    const int text_bottom = pbar_y >= 0
+        ? pbar_y - notif->fonts.body.regular->height
+        : height - pad_vertical;
+    center_glyphs_vertically(&glyphs, pad_vertical, text_bottom);
+
     const enum anchor placement = notif_anchor(notif);
     bool top_anchored
         = placement == ANCHOR_TOP_LEFT || placement == ANCHOR_TOP_CENTER ||
