+bool
+config_app_is_centered(const struct config *conf, const char *app_name)
+{
+    if (app_name == NULL)
+        return false;
+
+    const char *item = conf->center_app_names;
+    while (*item != '\0') {
+        while (*item == ' ' || *item == '\t' || *item == ',')
+            item++;
+
+        const char *end = item;
+        while (*end != '\0' && *end != ',')
+            end++;
+
+        const char *trimmed_end = end;
+        while (trimmed_end > item &&
+               (trimmed_end[-1] == ' ' || trimmed_end[-1] == '\t'))
+            trimmed_end--;
+
+        size_t len = trimmed_end - item;
+        if (strlen(app_name) == len && strncmp(item, app_name, len) == 0)
+            return true;
+
+        item = end;
+    }
+
+    return false;
+}
+
 void
 config_destroy(struct config conf)
 {
     free(conf.output);
     free(conf.icon_theme_name);
+    free(conf.center_app_names);
     free(conf.selection_helper);
     free_spawn_template(&conf.play_sound);
 
